# ═══════════════════════════════════════════════════════════════════════════
# Telco Churn Analytics — Environment Variables
# cp .env.example .env  (JANGAN push .env ke GitHub!)
# ═══════════════════════════════════════════════════════════════════════════

# ── Medallion Layer Paths ───────────────────────────────────────────────────
RAW_DATA_PATH=data/raw/telecom_customer.csv       # sumber CSV Kaggle
DUCKDB_PATH=data/gold/telco_warehouse.duckdb      # DuckDB: semua layer tersimpan di sini

# ── ML Integration ──────────────────────────────────────────────────────────
# Output dari Colab Fairuz (ML-10): customer_id, ml_churn_score, ml_churn_label
ML_SCORES_PATH=ml/models/churn_scores.csv

# ── ETL Config ──────────────────────────────────────────────────────────────
ETL_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# ── ML Config ───────────────────────────────────────────────────────────────
ML_TEST_SIZE=0.2
ML_RANDOM_STATE=42
ML_TARGET_COLUMN=churn
MODEL_OUTPUT_PATH=ml/models/best_model.joblib

# Dashboard access policy
APP_REQUIRE_DOCKER=true

# ── Segmentasi Threshold (Gold Layer / BA-05) ───────────────────────────────
CHURN_HIGH_RISK_THRESHOLD=0.7
CHURN_MEDIUM_RISK_THRESHOLD=0.4

METABASE_URL=http://metabase:3000
METABASE_USER=admin@telco.com
METABASE_PASS=Admin@1234
METABASE_DB_NAME=Telco Warehouse

CATALOG_URL=postgresql://admin:password123@catalog_db:5432/ducklake_catalog
