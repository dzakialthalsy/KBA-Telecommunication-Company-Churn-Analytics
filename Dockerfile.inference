FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH=/app
ENV APP_DOCKER_RUNTIME=true
ENV APP_REQUIRE_DOCKER=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["sh", "-c", "test -f ml/models/churn_inference_bundle.joblib || python dashboard/build_inference_bundle.py; uvicorn dashboard.churn_app:app --host 0.0.0.0 --port 8000"]
