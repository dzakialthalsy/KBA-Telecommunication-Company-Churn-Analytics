# ── Environment & Secrets ────────────────────────────────────────────────────
.env
*.env.local

# Bronze, Silver, Gold: data ada di dalam DuckDB, bukan di folder ini
# Folder hanya berisi .gitkeep — tetap di-track
# data/bronze/   ← jangan ignore (hanya berisi .gitkeep)
# data/silver/   ← jangan ignore (hanya berisi .gitkeep)
# data/gold/     ← jangan ignore (hanya berisi .gitkeep)

# File DuckDB (bisa besar, dibuat ulang dengan jalankan ETL)
data/gold/*.duckdb

# Output ML scores dari Google Colab (dibuat ulang dari model)
ml/models/churn_scores.csv

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Model Artifacts ───────────────────────────────────────────────────────────
# Model besar → simpan di GitHub Release atau cloud storage
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log