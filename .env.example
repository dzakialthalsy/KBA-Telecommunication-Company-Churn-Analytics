# ═══════════════════════════════════════════════════════════════════════════
# Telco Churn Analytics — Environment Variables
# Salin file ini: cp .env.example .env
# JANGAN push file .env ke GitHub!
# ═══════════════════════════════════════════════════════════════════════════

# ── Path Dataset ────────────────────────────────────────────────────────────
RAW_DATA_PATH=data/raw/telecom_customer.csv

# ── DuckDB ──────────────────────────────────────────────────────────────────
DUCKDB_PATH=data/mart/telco_warehouse.duckdb

# ── ETL Config ──────────────────────────────────────────────────────────────
ETL_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
ETL_BATCH_SIZE=10000        # jumlah baris per batch proses

# ── ML Config ───────────────────────────────────────────────────────────────
ML_TEST_SIZE=0.2            # proporsi data uji (20%)
ML_RANDOM_STATE=42          # seed untuk reproducibility
ML_TARGET_COLUMN=churn      # nama kolom target di dataset
MODEL_OUTPUT_PATH=ml/models/best_model.joblib

# ── Churn Risk Threshold ────────────────────────────────────────────────────
CHURN_HIGH_RISK_THRESHOLD=0.7    # skor >= 0.7 → High Risk
CHURN_MEDIUM_RISK_THRESHOLD=0.4  # skor 0.4–0.69 → Medium Risk

# ── Metabase (opsional, jika pakai external DB untuk Metabase) ──────────────
# METABASE_DB_HOST=localhost
# METABASE_DB_PORT=5432
